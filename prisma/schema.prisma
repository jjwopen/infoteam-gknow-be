// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Email {
  id Int @id @default(autoincrement())
  address String @unique
  professorId Int?
  professor Professor? @relation(fields: [professorId], references: [id])
  departmentId Int?
  department  Department? @relation(fields: [departmentId], references: [id])
}

model Professor {
  id Int @id @default(autoincrement())
  name String 
  nameKorea String
  emails Email[]
  course Course[]
  departments ProfessorDepartment[]
  imageURL String @default("https://example.com/default-image.jpg")
}

model Course {
  id Int @id @default(autoincrement())
  name String @unique
  code String @unique
  professors Professor[]
}

model Department {
  id Int @id @default(autoincrement())
  name String @unique
  nameKorea  String @unique
  address String? @unique
  professors ProfessorDepartment[]
  emails Email[]
}

model ProfessorDepartment {
  id           Int        @id @default(autoincrement())
  number       Int        @unique
  professor    Professor  @relation(fields: [professorId], references: [id])
  professorId  Int
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId Int

  @@unique([professorId, departmentId]) 
}

model Facility {
  id Int @id @default(autoincrement())
  name String @unique
  email String?
  startTime String
  endTime String
  number Int?
  location String?
}
